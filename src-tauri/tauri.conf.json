{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QzoneArchive",
  "version": "1.3.4",
  "identifier": "top.ehre.qzonearchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "空间归档",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost https://*.store.qq.com https://*.qlogo.cn https://*.qpic.cn https://*.qq.com https://*.gtimg.cn; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/videos/**/*", "$APPDATA/images/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Ehre",
    "category": "Utility",
    "shortDescription": "将 QQ 空间动态、照片、视频与互动记录安全归档到本地。",
    "longDescription": "空间归档是一款本地 QQ 空间归档工具，可以还原并保存原始动态、照片、视频、点赞和评论，支持多账号隔离、分页浏览与断点续传。",
    "copyright": "Copyright © 2026 Ehre",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav",
          "fonts-noto-cjk"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "空间归档"
      },
      "wix": {
        "upgradeCode": "24779296-0f03-5f99-83ea-fc2fcda733b9",
        "language": ["zh-CN", "en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyRDFBRDc2RjM5QzE2NkYKUldSdkZwenpkcTNSWWhWMFFIYU82bkJpeU5KRWIrNkl3SDFzRU1oSEpJaHVxTlZLMUdYRzRFT2IK",
      "endpoints": [
        "https://github.com/yuchen0x1/Qzone-Archive/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
